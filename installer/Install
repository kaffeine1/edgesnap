; EdgeSnap - installation script for the Commodore Installer.
; Copyright (c) 2026 Michele Dipace <michele.dipace@kaffeine.net>
; SPDX-License-Identifier: MIT
;
; Double-click the Install icon. The script recognises the system it is
; running on, proposes the matching build, and lets the user choose
; another - detection assists, it never decides on its own.

(set #app "EdgeSnap")

(set #app-version "0.2 beta")

(set #welcome
  (cat "EdgeSnap " #app-version "\n"
       "Window snapping for AmigaOS 4.x, MorphOS and AROS\n"
       "by Michele Dipace <michele.dipace@kaffeine.net>\n"
       "MIT license\n\n"
       "Drag a window against a screen edge or corner and it fills "
       "that half or quarter of the screen, the way Windows and macOS "
       "do. Two windows side by side share a seam that can be dragged "
       "to re-balance them. It installs as a commodity that starts "
       "with the system, so the behaviour is simply there."))

(set #ask-system "Which system is this?")
(set #ask-system-help
  (cat "EdgeSnap ships a build for each system. The one this machine "
       "looks like is already selected; change it only if you are "
       "installing onto another system's volumes.\n\n"))

(set #lib-prompt "Installing edgesnap.library into LIBS: ...")
(set #lib-help
  (cat "edgesnap.library holds everything EdgeSnap knows how to do. "
       "Other programs can use it too. If a newer one is already "
       "installed, it is kept.\n\n"))

(set #cmd-prompt "Installing the EdgeSnap commodity into C: ...")
(set #cmd-help
  (cat "The commodity is the part you interact with: it watches the "
       "mouse, draws the preview and the divider, and appears in "
       "Exchange like any other commodity.\n\n"))

(set #prefs-prompt "Installing the preferences window into SYS:Prefs: ...")
(set #prefs-help
  (cat "The preferences window is where the settings are changed: "
       "which zones react, how close to an edge the pointer must "
       "come, whether docks are kept clear. EdgeSnap notices the "
       "change straight away - there is no need to restart it.\n\n"))

(set #startup-prompt
  (cat "EdgeSnap should come up with the system, so that snapping is "
       "simply there and nobody has to start anything.\n\n"
       "This adds one line to S:User-Startup."))
(set #startup-help
  (cat "Without this line EdgeSnap has to be started by hand each "
       "time. The line can be removed later by editing "
       "S:User-Startup.\n\n"))

(set #guide-prompt "Where should the manual go?")
(set #guide-help
  (cat "EdgeSnap.guide is the manual: what the zones are, what every "
       "setting does, and how another program can use the library. It "
       "is the only part of the package that is not placed for you, "
       "because there is no one right drawer for documentation on "
       "these systems.\n\n"))

; The closing text is built LATER, once the manual's drawer is known:
; see the end of this script. Saying "nothing was installed into the
; drawer you ran this from" while the manual lived only there was how
; users came to delete their own documentation.
(set #done-head
  (cat "EdgeSnap " #app-version " is installed.\n"
       "by Michele Dipace <michele.dipace@kaffeine.net>\n\n"
       "Where it went:\n"
       "    LIBS:edgesnap.library\n"))
; the commodity's own place and how it starts differ on AROS: see
; #cmd-path and #startup-line, put together at the exit below
(set #done-mid
  (cat "    SYS:Prefs/EdgeSnap\n"))

; The line that starts the commodity is named in here, and it differs
; on AROS, so this text is put together at the end, once the system is
; known (see #startup-line and the exit at the bottom).
(set #done-tail-1
  (cat "\nEdgeSnap starts with the system at every boot. To start it by "
       "hand at any time:\n\n    "))
(set #done-tail-2
  (cat "\n\nThe settings are in SYS:Prefs/EdgeSnap - open it, change what "
       "you like, and EdgeSnap follows without being restarted. "
       "Exchange enables, disables or removes it as with any "
       "commodity."))

; Nothing here installs into @default-dest: the library, the commodity,
; the preferences window and the template each go to an absolute
; destination. But the Installer defaults @default-dest to the drawer
; the script was started from, and it names that drawer in its own
; closing message. Unpack into RAM:, run Install, and any implementation
; that ignores our (quiet) tells the user EdgeSnap "is in RAM:" - which
; is what a MorphOS user reported. Say where it really went instead.
(set @default-dest "SYS:")

(complete 0)
(welcome #welcome)

; Is an older EdgeSnap already on this machine? The answer changes how
; the installation can end: a fresh one can simply be started, an
; update has to deal with the previous version still being in memory.
(if (exists "LIBS:edgesnap.library" (noreq))
    (set #update 1)
    (set #update 0))

; --- which system? MorphOS is the one with MOSSYS:, AROS the one with
; aros.library -------------------------------------------------------
(if (exists "MOSSYS:" (noreq))
    (set #detected 1)
    (if (exists "LIBS:aros.library" (noreq))
        (set #detected 2)
        (set #detected 0)))

(set #system
  (askchoice
    (prompt #ask-system)
    (help #ask-system-help)
    (choices "AmigaOS 4.x" "MorphOS" "AROS x86_64")
    (default #detected)))

; Where the commodity lives and how it starts. On AmigaOS 4 and MorphOS
; it goes to C: with one line in S:User-Startup. On AROS a Run from
; S:User-Startup opens a console window for the new process and keeps
; it on screen for the whole session, whatever the redirections, so
; there the commodity goes to SYS:WBStartup with its icon, and Wanderer
; starts it without a console, as it starts every commodity there.
(set #startup-line "Run >NIL: C:EdgeSnap")
(set #cmd-dest "C:")
(set #cmd-path "C:EdgeSnap")
(if (= #system 0)
    (
      (set #libsrc "os4/edgesnap.library")
      (set #cmdsrc "os4/EdgeSnap")
      (set #prefssrc "os4/EdgeSnapPrefs")
    ))
(if (= #system 1)
    (
      (set #libsrc "mos/edgesnap.library")
      (set #cmdsrc "mos/EdgeSnap")
      (set #prefssrc "mos/EdgeSnapPrefs")
    ))
(if (= #system 2)
    (
      (set #libsrc "aros64/edgesnap.library")
      (set #cmdsrc "aros64/EdgeSnap")
      (set #prefssrc "aros64/EdgeSnapPrefs")
      (set #cmd-dest "SYS:WBStartup")
      (set #cmd-path "SYS:WBStartup/EdgeSnap")
      (if (exists "C:WBRun" (noreq))
          (set #startup-line "WBRun SYS:WBStartup/EdgeSnap")
          (set #startup-line "Run >NIL: <NIL: SYS:WBStartup/EdgeSnap"))
    ))

(complete 20)

; A file copied off a CD arrives with the CD's own protection bits:
; read and execute, no write and - the one that bites - no delete. The
; installation then works once and refuses for ever after, because it
; cannot replace what it put there itself. So: unlock what is already
; installed before replacing it, and leave everything we install in a
; state the next update can overwrite.
(if (exists "LIBS:edgesnap.library" (noreq))
    (protect "LIBS:edgesnap.library" "+rwed"))

; --- the library ----------------------------------------------------
(copylib
  (prompt #lib-prompt)
  (help #lib-help)
  (source #libsrc)
  (dest "LIBS:")
  (confirm))

(protect "LIBS:edgesnap.library" "+rwed")

(complete 50)

; --- the commodity --------------------------------------------------
(if (exists #cmd-path (noreq))
    (protect #cmd-path "+rwed"))

(copyfiles
  (prompt #cmd-prompt)
  (help #cmd-help)
  (source #cmdsrc)
  (dest #cmd-dest)
  (confirm))

(protect #cmd-path "+rwed")
; On AROS the icon beside it, as a plain file (see the preferences for
; why not (infos)): it is what makes Wanderer start it from WBStartup.
(if (= #system 2)
    (if (exists (cat #cmdsrc ".info") (noreq))
        (
          (copyfiles
            (source (cat #cmdsrc ".info"))
            (dest #cmd-dest))
          (protect (cat #cmd-path ".info") "+rwed")
        )))

(complete 60)

; --- the preferences window -----------------------------------------
;
; SYS:Prefs/ is where people look for it, so that is where it goes,
; icon included - a preferences program nobody can find is a text file
; with extra steps.
(if (exists "SYS:Prefs/EdgeSnap" (noreq))
    (protect "SYS:Prefs/EdgeSnap" "+rwed"))
(if (exists "SYS:Prefs/EdgeSnap.info" (noreq))
    (protect "SYS:Prefs/EdgeSnap.info" "+rwed"))

; On AROS the icon goes as a plain file: the Installer's (infos) copy
; hands every icon to icon.library, and AROS's stops with an illegal
; access on ours, classic or PNG alike, while Wanderer reads the same
; PNG icons without complaint (AROS One, 2026-09-05).
(if (= #system 2)
    (
      (copyfiles
        (prompt #prefs-prompt)
        (help #prefs-help)
        (source #prefssrc)
        (newname "EdgeSnap")
        (dest "SYS:Prefs")
        (confirm))
      (if (exists (cat #prefssrc ".info") (noreq))
          (copyfiles
            (source (cat #prefssrc ".info"))
            (newname "EdgeSnap.info")
            (dest "SYS:Prefs")))
    )
    (copyfiles
      (prompt #prefs-prompt)
      (help #prefs-help)
      (source #prefssrc)
      (newname "EdgeSnap")
      (dest "SYS:Prefs")
      (infos)
      (confirm)))

(protect "SYS:Prefs/EdgeSnap" "+rwed")
; The icon comes off the CD with the CD's own bits, and an icon that
; cannot be deleted stops the next installation dead.
(if (exists "SYS:Prefs/EdgeSnap.info" (noreq))
    (protect "SYS:Prefs/EdgeSnap.info" "+rwed"))

(complete 70)

; --- start it with the system ---------------------------------------
(if (= #system 2)
    (startup #app
      (prompt (cat "On AROS EdgeSnap starts from SYS:WBStartup, so no line is "
                   "needed in S:User-Startup. A note is left there in its "
                   "place, which also retires the line of an earlier "
                   "installation."))
      (help #startup-help)
      (command "; EdgeSnap starts from SYS:WBStartup\n"))
    (startup #app
      (prompt #startup-prompt)
      (help #startup-help)
      (command (cat #startup-line "\n"))))

(complete 90)

; --- the preferences template ---------------------------------------
(if (askbool
      (prompt "Install the commented preferences file into ENVARC:?")
      (help (cat "ENVARC:EdgeSnap.prefs is where EdgeSnap reads its "
                 "settings. The file installed here changes nothing on "
                 "its own: every setting in it is commented out.\n\n"))
      (default 1))
    (
      (if (exists "ENVARC:EdgeSnap.prefs" (noreq))
          (protect "ENVARC:EdgeSnap.prefs" "+rwed"))
      (copyfiles
        (source "EdgeSnap.prefs")
        (dest "ENVARC:"))
      (protect "ENVARC:EdgeSnap.prefs" "+rwed")))

; --- the manual -----------------------------------------------------
;
; The only piece with no obviously right home: these systems have no
; agreed drawer for documentation, and EdgeSnap has no application
; drawer of its own because its parts live in LIBS:, C: and Prefs. So
; the user chooses, with a sensible default, and the closing text says
; where it went - otherwise the manual stays in the unpacked drawer and
; is thrown away with it.
(set #guide-dest
  (askdir
    (prompt #guide-prompt)
    (help #guide-help)
    (default (if (= (exists "SYS:Documentation" (noreq)) 2)
                 "SYS:Documentation"
                 "SYS:"))))

; The icon too, before and after: it comes off the CD with the CD's
; own bits, and an icon that cannot be deleted stops the next
; installation dead. Found by installing 0.2 in the VM and listing the
; result: the guide was ----rwed and its icon ----r-e-.
(if (exists (tackon #guide-dest "EdgeSnap.guide") (noreq))
    (protect (tackon #guide-dest "EdgeSnap.guide") "+rwed"))
(if (exists (tackon #guide-dest "EdgeSnap.guide.info") (noreq))
    (protect (tackon #guide-dest "EdgeSnap.guide.info") "+rwed"))

; The manual and its icon; on AROS the icon as a plain file, for the
; reason given at the preferences above.
(if (= #system 2)
    (
      (copyfiles
        (source "EdgeSnap.guide")
        (dest #guide-dest))
      (if (exists "EdgeSnap.guide.info" (noreq))
          (copyfiles
            (source "EdgeSnap.guide.info")
            (dest #guide-dest)))
    )
    (copyfiles
      (source "EdgeSnap.guide")
      (dest #guide-dest)
      (infos)))

(protect (tackon #guide-dest "EdgeSnap.guide") "+rwed")
(if (exists (tackon #guide-dest "EdgeSnap.guide.info") (noreq))
    (protect (tackon #guide-dest "EdgeSnap.guide.info") "+rwed"))

(complete 95)

; What actually stands between an update and the new version running is
; the OLD one, still in memory and still holding the old library open.
; So stop it, let the library go, and start what was just installed -
; the user should not have to know the words "Avail FLUSH", and this
; Installer has no (reboot) to offer them instead.
(if (= #update 1)
    (
      (run (cat #cmd-path " QUIT"))
      (run "C:Wait >NIL: 2")
    ))

(run "C:Avail >NIL: FLUSH")

(complete 100)

(if (askbool
      (prompt (cat "EdgeSnap is installed.\n\nStart it now, so that "
                   "snapping works right away?"))
      (help (cat "EdgeSnap starts by itself at every boot in any case. "
                 "Saying yes here only saves you the wait - and, after "
                 "an update, puts the version just installed in charge "
                 "of the one that was running before.\n\n"))
      (default 1))
    (run #startup-line))

; (quiet): our own closing text says what happened - the Installer's
; standard one would add that EdgeSnap "is in Work:", which is not
; where any of it went.
(exit (cat #done-head
           "    " #cmd-path "\n"
           #done-mid
           (if (= #system 2)
               "    (started by Wanderer at every boot)\n"
               "    one line in S:User-Startup\n")
           "    " (tackon #guide-dest "EdgeSnap.guide") "\n\n"
           "Nothing else was installed into the drawer you ran this "
           "from, so it can be deleted.\n"
           #done-tail-1 #startup-line #done-tail-2)
      (quiet))
