; EdgeSnap - installation script for the Commodore Installer.
; Copyright (c) 2026 Michele Dipace <michele.dipace@kaffeine.net>
; SPDX-License-Identifier: MIT
;
; Double-click the Install icon. The script recognises the system it is
; running on, proposes the matching build, and lets the user choose
; another - detection assists, it never decides on its own.

(set #app "EdgeSnap")

(set #app-version "0.1 beta")

(set #welcome
  (cat "EdgeSnap " #app-version "\n"
       "Window snapping for AmigaOS 4.x and MorphOS\n"
       "by Michele Dipace <michele.dipace@kaffeine.net>\n"
       "MIT license\n\n"
       "Drag a window against a screen edge or corner and it fills "
       "that half or quarter of the screen, the way Windows and macOS "
       "do. Two windows side by side share a seam that can be dragged "
       "to re-balance them. It installs as a commodity that starts "
       "with the system, so the behaviour is simply there."))

(set #ask-system "Which system is this?")
(set #ask-system-help
  (cat "EdgeSnap ships a build for each system. The one this machine "
       "looks like is already selected; change it only if you are "
       "installing onto another system's volumes.\n\n"))

(set #lib-prompt "Installing edgesnap.library into LIBS: ...")
(set #lib-help
  (cat "edgesnap.library holds everything EdgeSnap knows how to do. "
       "Other programs can use it too. If a newer one is already "
       "installed, it is kept.\n\n"))

(set #cmd-prompt "Installing the EdgeSnap commodity into C: ...")
(set #cmd-help
  (cat "The commodity is the part you interact with: it watches the "
       "mouse, draws the preview and the divider, and appears in "
       "Exchange like any other commodity.\n\n"))

(set #prefs-prompt "Installing the preferences window into SYS:Prefs: ...")
(set #prefs-help
  (cat "The preferences window is where the settings are changed: "
       "which zones react, how close to an edge the pointer must "
       "come, whether docks are kept clear. EdgeSnap notices the "
       "change straight away - there is no need to restart it.\n\n"))

(set #startup-prompt
  (cat "EdgeSnap should come up with the system, so that snapping is "
       "simply there and nobody has to start anything.\n\n"
       "This adds one line to S:User-Startup."))
(set #startup-help
  (cat "Without this line EdgeSnap has to be started by hand each "
       "time. The line can be removed later by editing "
       "S:User-Startup.\n\n"))

; Say where the files went, in so many words. Nothing is installed
; into the drawer this script was launched from, but an Installer that
; names that drawer in a message of its own leaves the user believing
; otherwise - reported from MorphOS. Our own text should settle it.
(set #done
  (cat "EdgeSnap " #app-version " is installed.\n"
       "by Michele Dipace <michele.dipace@kaffeine.net>\n\n"
       "Where it went:\n"
       "    LIBS:edgesnap.library\n"
       "    C:EdgeSnap\n"
       "    SYS:Prefs/EdgeSnap\n"
       "    one line in S:User-Startup\n\n"
       "Nothing was installed into the drawer you ran this from: it "
       "can be deleted.\n\n"
       "EdgeSnap starts with the system at every boot. To start it by "
       "hand at any time:\n\n"
       "    Run >NIL: C:EdgeSnap\n\n"
       "The settings are in SYS:Prefs/EdgeSnap - open it, change what "
       "you like, and EdgeSnap follows without being restarted. "
       "Exchange enables, disables or removes it as with any "
       "commodity."))

; Nothing here installs into @default-dest: the library, the commodity,
; the preferences window and the template each go to an absolute
; destination. But the Installer defaults @default-dest to the drawer
; the script was started from, and it names that drawer in its own
; closing message. Unpack into RAM:, run Install, and any implementation
; that ignores our (quiet) tells the user EdgeSnap "is in RAM:" - which
; is what a MorphOS user reported. Say where it really went instead.
(set @default-dest "SYS:")

(complete 0)
(welcome #welcome)

; Is an older EdgeSnap already on this machine? The answer changes how
; the installation can end: a fresh one can simply be started, an
; update has to deal with the previous version still being in memory.
(if (exists "LIBS:edgesnap.library" (noreq))
    (set #update 1)
    (set #update 0))

; --- which system? MorphOS is the one with MOSSYS: ------------------
(if (exists "MOSSYS:" (noreq))
    (set #detected 1)
    (set #detected 0))

(set #system
  (askchoice
    (prompt #ask-system)
    (help #ask-system-help)
    (choices "AmigaOS 4.x" "MorphOS")
    (default #detected)))

(if (= #system 0)
    (
      (set #libsrc "os4/edgesnap.library")
      (set #cmdsrc "os4/EdgeSnap")
      (set #prefssrc "os4/EdgeSnapPrefs")
    )
    (
      (set #libsrc "mos/edgesnap.library")
      (set #cmdsrc "mos/EdgeSnap")
      (set #prefssrc "mos/EdgeSnapPrefs")
    ))

(complete 20)

; A file copied off a CD arrives with the CD's own protection bits:
; read and execute, no write and - the one that bites - no delete. The
; installation then works once and refuses for ever after, because it
; cannot replace what it put there itself. So: unlock what is already
; installed before replacing it, and leave everything we install in a
; state the next update can overwrite.
(if (exists "LIBS:edgesnap.library" (noreq))
    (protect "LIBS:edgesnap.library" "+rwed"))

; --- the library ----------------------------------------------------
(copylib
  (prompt #lib-prompt)
  (help #lib-help)
  (source #libsrc)
  (dest "LIBS:")
  (confirm))

(protect "LIBS:edgesnap.library" "+rwed")

(complete 50)

; --- the commodity --------------------------------------------------
(if (exists "C:EdgeSnap" (noreq))
    (protect "C:EdgeSnap" "+rwed"))

(copyfiles
  (prompt #cmd-prompt)
  (help #cmd-help)
  (source #cmdsrc)
  (dest "C:")
  (confirm))

(protect "C:EdgeSnap" "+rwed")

(complete 60)

; --- the preferences window -----------------------------------------
;
; SYS:Prefs/ is where people look for it, so that is where it goes,
; icon included - a preferences program nobody can find is a text file
; with extra steps.
(if (exists "SYS:Prefs/EdgeSnap" (noreq))
    (protect "SYS:Prefs/EdgeSnap" "+rwed"))
(if (exists "SYS:Prefs/EdgeSnap.info" (noreq))
    (protect "SYS:Prefs/EdgeSnap.info" "+rwed"))

(copyfiles
  (prompt #prefs-prompt)
  (help #prefs-help)
  (source #prefssrc)
  (newname "EdgeSnap")
  (dest "SYS:Prefs")
  (infos)
  (confirm))

(protect "SYS:Prefs/EdgeSnap" "+rwed")
; The icon comes off the CD with the CD's own bits, and an icon that
; cannot be deleted stops the next installation dead.
(if (exists "SYS:Prefs/EdgeSnap.info" (noreq))
    (protect "SYS:Prefs/EdgeSnap.info" "+rwed"))

(complete 70)

; --- start it with the system ---------------------------------------
(startup #app
  (prompt #startup-prompt)
  (help #startup-help)
  (command "Run >NIL: C:EdgeSnap\n"))

(complete 90)

; --- the preferences template ---------------------------------------
(if (askbool
      (prompt "Install the commented preferences file into ENVARC:?")
      (help (cat "ENVARC:EdgeSnap.prefs is where EdgeSnap reads its "
                 "settings. The file installed here changes nothing on "
                 "its own: every setting in it is commented out.\n\n"))
      (default 1))
    (
      (if (exists "ENVARC:EdgeSnap.prefs" (noreq))
          (protect "ENVARC:EdgeSnap.prefs" "+rwed"))
      (copyfiles
        (source "EdgeSnap.prefs")
        (dest "ENVARC:"))
      (protect "ENVARC:EdgeSnap.prefs" "+rwed")))

(complete 95)

; What actually stands between an update and the new version running is
; the OLD one, still in memory and still holding the old library open.
; So stop it, let the library go, and start what was just installed -
; the user should not have to know the words "Avail FLUSH", and this
; Installer has no (reboot) to offer them instead.
(if (= #update 1)
    (
      (run "C:EdgeSnap QUIT")
      (run "C:Wait >NIL: 2")
    ))

(run "C:Avail >NIL: FLUSH")

(complete 100)

(if (askbool
      (prompt (cat "EdgeSnap is installed.\n\nStart it now, so that "
                   "snapping works right away?"))
      (help (cat "EdgeSnap starts by itself at every boot in any case. "
                 "Saying yes here only saves you the wait - and, after "
                 "an update, puts the version just installed in charge "
                 "of the one that was running before.\n\n"))
      (default 1))
    (run "Run >NIL: C:EdgeSnap"))

; (quiet): our own closing text says what happened - the Installer's
; standard one would add that EdgeSnap "is in Work:", which is not
; where any of it went.
(exit #done (quiet))
