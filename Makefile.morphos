# MorphOS lane (PPC). Build via ../morphos-cross (pkgsrc gcc container):
#   scripts/build-morphos.sh
# -noixemul is mandatory for native Amiga API calls (headers enforce it).

# Hard assignment: the container environment presets CC=cc.
CC = ppc-morphos-gcc
CFLAGS ?= -Wall -Wextra -O2 -noixemul -Icore -Iinclude -Ilibrary
TARGET ?= build/morphos/EdgeSnap
# The commodity no longer links the library body: it OPENS
# edgesnap.library. It keeps only what a frontend needs -
# zone names for its log, and the preferences parser.
SRC := commodity/edgesnap_cx.c core/zones.c core/engine.c core/config.c

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(SRC) core/zones.h
	mkdir -p "$(dir $(TARGET))"
	$(CC) $(CFLAGS) -o "$@" $(SRC)

clean:
	rm -f "$(TARGET)"
