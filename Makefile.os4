# AmigaOS 4.x lane (PPC). Build via ../os4-cross (walkero gcc11 container):
#   scripts/build-os4.sh
# Own code is C89-style, but no -std= is forced: the SDK headers decide.

# Hard assignment: container environments may preset CC.
CC = ppc-amigaos-gcc
CFLAGS ?= -Wall -Wextra -O2 -Icore -Iinclude -Ilibrary
TARGET ?= build/os4/EdgeSnap
# The commodity no longer links the library body: it OPENS
# edgesnap.library. It keeps only what a frontend needs -
# zone names for its log, and the preferences parser.
SRC := commodity/edgesnap_cx.c core/zones.c core/engine.c core/config.c

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(SRC) core/zones.h
	mkdir -p "$(dir $(TARGET))"
	$(CC) $(CFLAGS) -o "$@" $(SRC)

clean:
	rm -f "$(TARGET)"
