##base _EdgeSnapBase
##bias 30
##public
ESnap_QueryCapabilities()()
ESnap_SnapWindow(win,zone)(a0,d0)
ESnap_UnsnapWindow(win)(a0)
ESnap_QueryWindow(win,zoneOut)(a0,a1)
ESnap_ExcludeWindow(win,exclude)(a0,d0)
ESnap_SetOptionsA(tags)(a0)
ESnap_Enable(on)(d0)
ESnap_FeedInput(presses,motions,releases,qualifiers,report)(d0,d1,d2,d3,a0)
ESnap_ResetInput(report)(a0)
ESnap_IgnoreWindows(windows,count)(a0,d0)
ESnap_QueryScreenArea(screen,area)(a0,a1)
ESnap_QueryDivider(thickness,divider)(d0,a0)
ESnap_MoveDivider(position)(d0)
ESnap_QueryDividerAt(thickness,x,y,divider)(d0,d1,d2,a0)
ESnap_MoveDividerAt(vertical,line,position)(a0,a1,d0)
ESnap_QueryWindows(screen,buf,count,needed)(a0,a1,d0,a2)
ESnap_QueryGeneration(screen)(a0)
ESnap_PlaceWindow(win,rect,flags)(a0,a1,d0)
ESnap_PlaceWindowsA(list,count,flags)(a0,d0,d1)
##end
